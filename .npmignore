# NOTE: package.json "files" is the authority for what ships to npm.
# This file only matters for the paths "files" lets through.

# Development files
node_modules/
.git/
.gitignore
eslint.config.mjs
.stylelintrc.json

# Build artifacts that aren't needed
webpack.config.js

# Documentation that's not essential for npm users
.github/
docs/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Temporary folders
tmp/
temp/